playerevent join {
    player.giveItems(item("diamond_sword"));
    player.setCombatAttribute(1024, attr = "Attack speed");
}

playerevent leftClick {
    attack_melee();
}

function attack_melee() {
    line angle1 = num.random(0, 3.142, rounding = "Decimal number");
    line angle2 = angle1 + 3.142;

    line a1x = angle1.cos(unit = "Radians");
    line a1y = angle1.sin(unit = "Radians");

    line a2x = angle2.cos(unit = "Radians");
    line a2y = angle2.sin(unit = "Radians");

    line circleCenter = player.eyeLocation.shiftOnVector(player.direction * 3);

    line lineLength = 3;

    line corner1 = circleCenter.shiftAllDirections(0, a1y * (lineLength / 2), a1x * (lineLength / 2));
    line corner2 = circleCenter.shiftAllDirections(0, a2y * (lineLength / 2), a2x * (lineLength / 2));

    line step = 0.1;
    line peak = (lineLength * 1/step) / 2;

    line idx = 0;
    for(line tmp of path(corner1, corner2, step)) {
        line extraDist = num.sin((3.141/(2 * peak)) * idx, unit = "Radians") * (lineLength / 2);
        print(extraDist, idx, peak);
        tmp = tmp.setDirection(player.eyeLocation.getDirection());
        tmp = tmp.shiftInDirection(extraDist);
        player.displayParticleEffect(par("crit"), tmp);
        idx += 1;
        if(idx % 20 == 0) {
            wait(1);
        }
    }
}