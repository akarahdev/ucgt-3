gameevent startup {
    declare global port: num = 37615;
    declare global webUrl: str = "http://bigcircl.akarah.net";

    enqueueInit();
    registries_init();
}

playerevent join {
    player.setCombatAttribute(1024, attr = "Attack speed");
    player.setReachAttribute(0, attr = "Entity interaction range");
    player.setReachAttribute(0, attr = "Block interaction range");
}

playerevent command {
    if(event.commandArgumentEquals("summon", 1)) {
        line mt = event.commandArguments[2];
        spawnMobFromType(mt, player.eyeLocation);
    }
    if(event.commandArgumentEquals("give", 1)) {
        line it = event.commandArguments[2];
        player.giveItems(buildItemFromType(it));
    }
}

playerevent exhaustion {
    event.cancel();
}

playerevent swapHands {
    event.cancel();
}