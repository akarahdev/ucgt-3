gameevent startup {
    declare global port: num = 35857;
    declare global webUrl: str = "http://bigcircl.akarah.net";
}

function request(path: str): any {
    print(webUrl + ":" + port + path);
    return var.getWebResponse(
        webUrl + ":" + port + path,
        method = "Get"
    );
}

playerevent join {
    repeat {
        line req = request("/v1/hello");
        player.sendMessage(req);
        wait(1);
    }
}