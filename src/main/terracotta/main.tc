gameevent startup {
    declare global port: num = 37615;
    declare global webUrl: str = "http://bigcircl.akarah.net";

    global plotReady: num = 0;

    enqueueInit();

    enqueueRequestBlocking("GET", "/v1/meow", {});

    registriesInit();

    select allPlayers();
    start virtualJoin(targetMode = "For each in selection");
    select reset();

    plotReady = 1;
}

playerevent join {
    player.setCombatAttribute(1024, attr = "Attack speed");
    player.setReachAttribute(0, attr = "Entity interaction range");
    player.setReachAttribute(4, attr = "Block interaction range");
    player.setToAdventureMode();

    global plotReady: num;
    if(plotReady == 1) {
        start virtualJoin(targetMode = "With current targets");
    }

    allPlayers.setAllowHandCrafting(allow = "Disable");
}

process virtualJoin() {
    line playerData = playerGetData(player.uuid);
    playerSetData(player.uuid, player.name.clearFormatting());
    if(var.equals(playerData, 0)) {
        storageAdd(player.uuid, "wooden_sword");
        return;
    }

    line sword = storageGetSword(player.uuid);
    if(sword != "") {
        player.setItemInSlot(buildItemFromType(sword), 1);
    }

    line bow = storageGetBow(player.uuid);
    if(bow != "") {
        player.setItemInSlot(buildItemFromType(bow), 2);
    }
}

playerevent command {
    if(event.commandArgumentEquals("summon", 1)) {
        line mt = event.commandArguments[2];
        spawnMobFromType(mt, player.eyeLocation);
    }
    if(event.commandArgumentEquals("give", 1)) {
        line it = event.commandArguments[2];
        player.giveItems(buildItemFromType(it));
    }
    if(event.commandArgumentEquals("store", 1)) {
        line it = event.commandArguments[2];
        storageAdd(player.uuid, it);
    }
}

playerevent exhaustion {
    event.cancel();
}

playerevent swapHands {
    event.cancel();
}

playerevent takeDamage {
    event.setDamage(0.001);
}

playerevent dropItem {
    event.cancel();
}

playerevent leftClick {
    if(player.mainHandItem.hasTag("type", "sword") && player.itemIsNotOnCooldown(player.mainHandItem)) {
        player.setItemCooldown(player.mainHandItem, 10);
        attackMelee();
        event.cancel();
        endthread;
    }
}

playerevent rightClick {
    if(player.mainHandItem.hasTag("type", "bow") && player.itemIsNotOnCooldown(player.mainHandItem)) {
        player.setItemCooldown(player.mainHandItem, 10);
        attackShoot();
        event.cancel();
        endthread;
    }
    if(game.blockEquals(event.blockLocation, item("chest"))) {
        event.cancel();
        openStorageMenu();
    }
}

playerevent clickMenuSlot {
    storageMenuClick();
}

playerevent clickInventorySlot {
    event.cancel();
}