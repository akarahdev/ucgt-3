function getMobType(id: str): {
    name: str,
    type: str,
    reward: num,
    stats: dict[num]
} {
    return global "registry.mob_type.%var(id)" as {
        name: str,
        type: str,
        reward: num,
        stats: dict[num]
    };
}

function spawnMobFromType(id: str, position: loc): str {
    line mobType = getMobType(id);

    game.spawnMob(item(mobType["type"] + "_spawn_egg"), position);

    line uuid = lastEntity.uuid;
    select entitiesByUUID(uuid);
    selectedEntity.setEquipmentItem(item("acacia_button"), slot = "Head");
    selectedEntity.setDeathDropsEnabled(spawnDrops = "Disable");
    selectedEntity.setTag("reward", mobType["reward"]);

    line hp = mobType["stats"]["max_health"];
    selectedEntity.setTag("health", hp);
    selectedEntity.setCustomName(s"<red>%var(hp)❤");

    select reset();

    return uuid;
}