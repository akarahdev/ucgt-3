function alphabet(): list[str] {
    if(!var.exists(global alphabet)) {
        global alphabet = (
            "abcdefghijklmnopqrstuvwxyz"
            + "ABCDEFGHIJKLMNOPQRSTUVWXYZ1234567890"
            + "-=[];',/.{}|>?_+!@#$%^&*()"
        ).split("").removeDuplicates();
    }
    return (global alphabet as list[str]);
}

function save(corner1: loc, corner2: loc): list[str] {
    line palette: list[str] = [];

    line output: list[str] = [""];

    for(line idx of grid(corner1, corner2)) {
        if(game.blockEquals(idx, "air")) {
            continue;
        }

        line offset = vec.between(corner1, idx);
        line blockType = game.getBlockMaterial(idx);
        line blockData = game.getAllBlockData(idx);

        line paletteStr = blockType + ";" + blockData;
        line paletteIdx = palette.find(paletteStr);
        if(paletteIdx == 0) {
            palette.append(paletteStr);
            paletteIdx = palette.len();
        }

        line lastOutput = output[output.len()];
        if(lastOutput.len() > 8000) {
            output.append("");
            lastOutput = "";
        }

        lastOutput += "%index(offset,1);%index(offset,2);%index(offset,3);%var(paletteIdx)|";

        output[output.len()] = lastOutput;
    }

    output.insert(1, palette.join("|"));

    return output;
}

function place(corner1: loc, data: list[str]) {
    line palette: list[str] = data[1].split("|");

    line output: list[str] = data.trim(2);

    for(line sublist of output) {
        for(line subelem of sublist.split("|")) {
            line subsplit = subelem.split(";");
            line offset = vec(
                num.parse(subsplit[1]),
                num.parse(subsplit[2]),
                num.parse(subsplit[3]),
            );
            line paletteEntry = palette[num.parse(subsplit[4])].split(";");

            line paletteBlock = paletteEntry[1];
            line paletteData = paletteEntry[2];
            game.setBlock(paletteBlock as item, corner1 + offset, paletteData);
        }
    }
}