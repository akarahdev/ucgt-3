function getBanner(id: str): {
    name: str,
    cost: num,
    camera: { x: num, y: num, z: num, pitch: num, yaw: num },
    weights: dict[num]
} {
    return global "registry.banner.%var(id)" as {
        name: str,
        cost: num,
        camera: { x: num, y: num, z: num, pitch: num, yaw: num },
        weights: dict[num]
    };
}

function executeRoll(uuid: str, banner: str, count: num = 1): list[str] {
    return enqueueRequestBlocking(
        "GET",
        "/v1/roll/" + uuid + "/" + banner + "?count=" + count,
        {}
    ) as list[str];
}

function openBanner(id: str) {
    line bannerType = getBanner(id);

    global "%uuid openBanner" = id;
    if(!(var.exists(global "%uuid oldLocation"))) {
        global "%uuid oldLocation" = player.location;
    }

    player.setToSpectatorMode();
    player.teleport(loc(
        bannerType["camera"]["x"],
        bannerType["camera"]["y"],
        bannerType["camera"]["z"],
        bannerType["camera"]["pitch"],
        bannerType["camera"]["yaw"]
    ));

    line menu = dialog.create(
        "banner",
        txt.parseExpression("<green>" + bannerType["name"]),
        afterAction = "None",
        type = "Multi Action",
        canClose = "False"
    );

    line weightSum = 0;
    for(line key, line val of bannerType["weights"]) {
        weightSum += val;
    }
    for(line key, line val of bannerType["weights"]) {
        line itemType = getItemType(key);
        menu.addBodyText(
            txt.parseExpression(
                "<white>" + itemType["name"]
                + "<dark_gray> - <red>"
                + ((val / weightSum) * 100) + "%"
            )
        );
    }

    menu.addButton(s"←", "left", 20);
    menu.addButton(s"<red>Exit", "exit", 80);
    menu.addButton(s"<yellow>Roll", "roll", 80);
    menu.addButton(s"→", "right", 20);

    menu.setColumnCount(4);

    player.openDialog(menu);
}

function clickBannerDialog() {
    line banners: list[str] = [
        "basic",
        "grasslands"
    ];
    if(event.clickedDialogId == "banner") {
        if(event.clickedButtonId == "left") {
            line idx = banners.find(global "%uuid selectedBanner" as str);
            line nextIdx = num.wrap(idx - 1, 1, banners.len() + 1);
            global "%uuid selectedBanner" = banners[nextIdx];
            openBanner(global "%uuid selectedBanner" as str);
            return;
        }
        if(event.clickedButtonId == "right") {
            line idx = banners.find(global "%uuid selectedBanner" as str);
            line nextIdx = num.wrap(idx + 1, 1, banners.len() + 1);
            global "%uuid selectedBanner" = banners[nextIdx];
            openBanner(global "%uuid selectedBanner" as str);
            return;
        }
        if(event.clickedButtonId == "exit") {
            player.closeInventory();
            player.teleport(global "%uuid oldLocation" as loc);
            player.setToAdventureMode();
            var.purgeMatching("%uuid oldLocation", matchRequirement = "Entire name");
        }
        if(event.clickedButtonId == "roll") {
            line openBanner = getBanner(global "%uuid openBanner" as str);
            if(playerGetCoins(player.uuid) > openBanner["cost"]) {
                playerSetCoins(player.uuid, playerGetCoins(player.uuid) - openBanner["cost"]);

                line items = executeRoll(player.uuid, global "%uuid openBanner" as str, 1);
                print(items);

                player.closeInventory();
                player.teleport(global "%uuid oldLocation" as loc);
                player.setToAdventureMode();
                var.purgeMatching("%uuid oldLocation", matchRequirement = "Entire name");
            } else {
                player.sendMessage(s"<red>Error: <gray>You can't afford that!");
            }
        }
    }
}
